   <plugin id="org.jawata.core" version="0.0.0" unpack="false"/>
   <plugin id="org.jawata.mcp" version="0.0.0" unpack="false"/>
   <plugin id="org.jawata.catalogue" version="0.0.0" unpack="false"/>
   <plugin id="com.h2database" version="0.0.0" unpack="false"/>

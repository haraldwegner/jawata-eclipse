<?xml version="1.0" encoding="UTF-8"?>
<!-- PDE tests: they start an Eclipse workbench, so the build runs under xvfb-run (spec D6, D7). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jawata.eclipse</groupId>
    <artifactId>jawata-eclipse-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>org.jawata.eclipse.tests</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>eclipse-test-plugin</packaging>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <dependency-resolution>
            <extraRequirements>
              <requirement><type>eclipse-feature</type><id>org.eclipse.platform</id><versionRange>0.0.0</versionRange></requirement>
              <requirement><type>eclipse-feature</type><id>org.eclipse.mylyn.wikitext.feature</id><versionRange>0.0.0</versionRange></requirement>
              <requirement><type>eclipse-feature</type><id>org.eclipse.terminal.feature</id><versionRange>0.0.0</versionRange></requirement>
            </extraRequirements>
          </dependency-resolution>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-surefire-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <useUIHarness>true</useUIHarness>
          <useUIThread>false</useUIThread>
          <product>org.eclipse.platform.ide</product>
          <application>org.eclipse.ui.ide.workbench</application>
          <!-- The engine the workbench starts writes its note here and not into the machine's real cache folder, where studio would list
               the test run as a running Eclipse workspace (plan Stage 16, step 16.5). -->
          <systemProperties>
            <jawata.engine.notes.dir>${project.build.directory}/engine-notes</jawata.engine.notes.dir>
            <jawata.ux.dir>${project.build.directory}/ux</jawata.ux.dir>
          </systemProperties>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The released engine's bundles in Tycho's own test runtime, so EngineBundlesResolveTest sees them (plan Stage 15). Not in the
         in-download run below: there the engine comes from the installed update site, and asking for the feature again would install
         a second build of it (a newer qualifier) beside the installed one, which p2 refuses. -->
    <profile>
      <id>engine-in-runtime</id>
      <activation><property><name>!jawata.download</name></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>target-platform-configuration</artifactId>
            <version>${tycho.version}</version>
            <configuration>
              <dependency-resolution>
                <extraRequirements combine.children="append">
                  <requirement><type>eclipse-feature</type><id>org.jawata.engine.feature</id><versionRange>0.0.0</versionRange></requirement>
                </extraRequirements>
              </dependency-resolution>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- a real spec to open as well as the fixture: mvn -Djawata.spec.md=PATH (the specs stay out of this public repository); set only
         when given, because an empty property would reach the test as the text "null" -->
    <profile>
      <id>real-spec</id>
      <activation><property><name>jawata.spec.md</name></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>tycho-surefire-plugin</artifactId>
            <version>${tycho.version}</version>
            <configuration>
              <systemProperties>
                <jawata.spec.md>${jawata.spec.md}</jawata.spec.md>
              </systemProperties>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- the same tests inside a real Eclipse download (plan Stage 13, D6/D7): scripts/28k-e2e.sh installs the update site into a fresh
         copy, then runs this module with -Djawata.download=<its eclipse dir> -Djawata.profile=<its p2 profile> -Djawata.product=<its product>;
         Tycho installs the test bundle and its harness on top of that installation with the p2 director and starts it -->
    <profile>
      <id>in-download</id>
      <activation><property><name>jawata.download</name></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>tycho-surefire-plugin</artifactId>
            <version>${tycho.version}</version>
            <configuration>
              <testRuntime>p2Installed</testRuntime>
              <work>${jawata.download}</work>
              <profileName>${jawata.profile}</profileName>
              <product>${jawata.product}</product>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

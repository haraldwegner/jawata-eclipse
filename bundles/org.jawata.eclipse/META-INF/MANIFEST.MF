Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: jawata
Bundle-SymbolicName: org.jawata.eclipse;singleton:=true
Bundle-Version: 0.1.0.qualifier
Bundle-Vendor: Harald Wegner
Bundle-RequiredExecutionEnvironment: JavaSE-21
Automatic-Module-Name: org.jawata.eclipse
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.ui,
 org.eclipse.ui.ide,
 org.eclipse.ui.editors,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.jface.text,
 org.eclipse.mylyn.wikitext,
 org.eclipse.mylyn.wikitext.markdown,
 org.eclipse.mylyn.wikitext.ui
Import-Package: org.commonmark.ext.gfm.tables;version="[0.30.0,1.0.0)",
 org.commonmark.node;version="[0.30.0,1.0.0)",
 org.commonmark.parser;version="[0.30.0,1.0.0)",
 org.eclipse.ltk.core.refactoring,
 org.jawata.mcp.engine;version="[1.0,2.0)",
 org.jawata.spi.host;version="[1.0,2.0)"
Export-Package: org.jawata.eclipse.host;x-friends:="org.jawata.eclipse.tests",
 org.jawata.eclipse.specs

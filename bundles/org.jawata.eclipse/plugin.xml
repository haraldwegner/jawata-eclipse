<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <!-- Spec D6 (his option B): Markdown files open in WikiText's editor reading the specs' pipe tables. Bound to WikiText's own
        Markdown content type, which is more specific than the parent type WikiText's editor is bound to, so this is the default for
        .md; Open With still offers WikiText's editor. Nothing is registered for the md extension (WikiText keeps the first). -->
   <extension point="org.eclipse.ui.editors">
      <editor
            id="org.jawata.eclipse.specs.markdownEditor"
            name="Markdown (jawata, with tables)"
            class="org.jawata.eclipse.specs.SpecMarkdownEditor"
            contributorClass="org.eclipse.mylyn.internal.wikitext.ui.editor.MarkupEditorActionBarContributor"
            default="true"
            symbolicFontName="org.eclipse.mylyn.wikitext.ui.presentation.textFont">
         <contentTypeBinding contentTypeId="org.eclipse.mylyn.wikitext.markdown"/>
      </editor>
   </extension>
   <!-- Spec D2: the engine runs inside Eclipse and the person starts nothing. Eclipse calls this after the workbench is up, on a thread
        of its own, and the engine is ended when the workbench shuts down. -->
   <extension point="org.eclipse.ui.startup">
      <startup class="org.jawata.eclipse.host.EngineStartup"/>
   </extension>
   <!-- Spec D5: every setting of the engine is an Eclipse preference. One page built from the engine's own list of settings;
        the initializer says what the engine's working folders are when the person set none. -->
   <extension point="org.eclipse.ui.preferencePages">
      <page id="org.jawata.eclipse.preferences.jawata" name="jawata" class="org.jawata.eclipse.preferences.JawataPreferencePage"/>
   </extension>
   <!-- Spec D4, contract §6.1 path B: Run > Run for jawata starts one of the person's run configurations in Run mode with the debug
        agent, so the agent can attach while the person reproduces a problem. The entries are read when the menu opens. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:org.eclipse.ui.run?after=additions">
         <menu id="org.jawata.eclipse.run.forJawata" label="Run for jawata">
            <dynamic id="org.jawata.eclipse.run.forJawata.configurations" class="org.jawata.eclipse.run.RunForJawataMenu"/>
         </menu>
      </menuContribution>
   </extension>
   <!-- Spec D8, plan Stage 22 (W7): File > Import a VS Code workspace reads a .code-workspace file and opens Eclipse's Smart Import wizard for
        each folder it names, so the person confirms every import; jawata creates no project. -->
   <extension point="org.eclipse.ui.commands">
      <command id="org.jawata.eclipse.importCodeWorkspace"
               name="Import a VS Code workspace"
               description="Reads the folders a .code-workspace file names and opens Eclipse's Smart Import for each, so you confirm every import.">
         <commandParameter id="org.jawata.eclipse.importCodeWorkspace.file" name="Workspace file" optional="true"/>
      </command>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="org.jawata.eclipse.importCodeWorkspace" class="org.jawata.eclipse.imports.ImportCodeWorkspaceHandler"/>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:file?after=import.ext">
         <command commandId="org.jawata.eclipse.importCodeWorkspace" label="Import a VS Code workspace..." style="push"
                  tooltip="Reads the folders a .code-workspace file names and opens Smart Import for each"/>
      </menuContribution>
   </extension>
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="org.jawata.eclipse.host.EnginePreferenceInitializer"/>
   </extension>
   <!-- Spec D14, plan Stage 13b: comments and suggested changes in a Markdown file, written as plain-text CriticMarkup and shown as callouts
        in the preview. Five commands on the editor, in its context menu; only the person runs them, and each edits the open text and nothing
        else. -->
   <extension point="org.eclipse.ui.commands">
      <command id="org.jawata.eclipse.specs.comment" name="Comment"
               description="Writes your comment after the selected text, as a {&gt;&gt; ... &lt;&lt;} mark in the file.">
         <commandParameter id="org.jawata.eclipse.specs.text" name="Comment" optional="true"/>
      </command>
      <command id="org.jawata.eclipse.specs.suggestChange" name="Suggest change"
               description="Marks the selected text as removed and opens an addition after it, as {-- ... --}{++ ... ++} marks in the file.">
         <commandParameter id="org.jawata.eclipse.specs.text" name="Addition" optional="true"/>
      </command>
      <command id="org.jawata.eclipse.specs.accept" name="Accept change"
               description="Accepts the comment or suggested change at the cursor: an addition becomes text, a removal takes its text out."/>
      <command id="org.jawata.eclipse.specs.reject" name="Reject change"
               description="Rejects the suggested change at the cursor: an addition is dropped, a removal keeps its text."/>
      <command id="org.jawata.eclipse.specs.resolve" name="Resolve comment"
               description="Removes the comment at the cursor from the file."/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="org.jawata.eclipse.specs.comment" class="org.jawata.eclipse.specs.CalloutCommandHandler">
         <activeWhen><with variable="activeEditorId"><equals value="org.jawata.eclipse.specs.markdownEditor"/></with></activeWhen>
      </handler>
      <handler commandId="org.jawata.eclipse.specs.suggestChange" class="org.jawata.eclipse.specs.CalloutCommandHandler">
         <activeWhen><with variable="activeEditorId"><equals value="org.jawata.eclipse.specs.markdownEditor"/></with></activeWhen>
      </handler>
      <handler commandId="org.jawata.eclipse.specs.accept" class="org.jawata.eclipse.specs.CalloutCommandHandler">
         <activeWhen><with variable="activeEditorId"><equals value="org.jawata.eclipse.specs.markdownEditor"/></with></activeWhen>
      </handler>
      <handler commandId="org.jawata.eclipse.specs.reject" class="org.jawata.eclipse.specs.CalloutCommandHandler">
         <activeWhen><with variable="activeEditorId"><equals value="org.jawata.eclipse.specs.markdownEditor"/></with></activeWhen>
      </handler>
      <handler commandId="org.jawata.eclipse.specs.resolve" class="org.jawata.eclipse.specs.CalloutCommandHandler">
         <activeWhen><with variable="activeEditorId"><equals value="org.jawata.eclipse.specs.markdownEditor"/></with></activeWhen>
      </handler>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu id="org.jawata.eclipse.specs.callouts" label="Comments and changes">
            <command commandId="org.jawata.eclipse.specs.comment" label="Comment..." style="push" tooltip="Writes your comment after the selected text, as a mark in the file"/>
            <command commandId="org.jawata.eclipse.specs.suggestChange" label="Suggest change..." style="push" tooltip="Marks the selected text as removed and opens an addition for what it should become"/>
            <separator name="resolution" visible="true"/>
            <command commandId="org.jawata.eclipse.specs.accept" label="Accept" style="push" tooltip="Accepts the mark at the cursor: an addition becomes text, a removal takes its text out"/>
            <command commandId="org.jawata.eclipse.specs.reject" label="Reject" style="push" tooltip="Rejects the mark at the cursor: an addition is dropped, a removal keeps its text"/>
            <command commandId="org.jawata.eclipse.specs.resolve" label="Resolve comment" style="push" tooltip="Removes the comment at the cursor from the file"/>
            <visibleWhen checkEnabled="false">
               <with variable="activeEditorId"><equals value="org.jawata.eclipse.specs.markdownEditor"/></with>
            </visibleWhen>
         </menu>
      </menuContribution>
   </extension>
</plugin>
